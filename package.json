{
  "name": "elementals-simulation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Headless balance simulation and CMA-ES balance search for Elementals",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:list": "node scripts/test.mjs --list",
    "sim": "tsx simulation/src/cli.ts",
    "search": "node dist/simulation/src/kaggleSearch.js",
    "smoke": "node dist/simulation/src/kaggleSearch.js --generations 1 --population 4 --promote 1 --validate 0 --out runs/smoke",
    "build": "tsc -p tsconfig.build.json",
    "search:tsx": "tsx simulation/src/kaggleSearch.ts",
    "bench": "node dist/simulation/src/perf/profile.js",
    "profile": "node --cpu-prof --cpu-prof-dir=runs/prof dist/simulation/src/perf/profile.js",
    "bench:workers": "node dist/simulation/src/perf/workerBench.js",
    "test:persistence": "python kaggle/test_checkpoint_store.py"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3"
  }
}
