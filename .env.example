# Template. Copy to .env and fill in real values.
#
#   cp .env.example .env
#
# .env is gitignored and must stay that way — it holds live credentials.
# This file is committed and must never contain a real key.
#
# On Kaggle there is no .env: the same names come from Add-ons -> Secrets,
# so the code reads process.env either way and nothing changes between
# local development and a notebook.

# ---------------------------------------------------------------------------
# Supabase — the live job queue for distributed evaluation
# ---------------------------------------------------------------------------
# Project Settings -> API. The URL is not a secret; the keys are.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable (formerly "anon") key. Safe to hand to every worker: it is
# restricted by row-level security, so a worker can claim and complete jobs and
# nothing else. This is the only key the five or six Kaggle workers need.
SUPABASE_PUBLISHABLE_KEY=

# Secret (formerly "service_role") key. Bypasses row-level security entirely.
#
# LEAVE THIS BLANK unless the coordinator turns out to need it. Only ONE
# process would ever use it — the coordinator, to create experiments and
# insert jobs — and it must never be attached to a worker notebook. Whether it
# is needed at all depends on how the RLS policies land; if the publishable key
# can do the job under a policy, this stays empty.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Experiment identity
# ---------------------------------------------------------------------------
# Shared by the coordinator and every worker so they agree on which run they
# are part of. A worker refuses a job whose experiment does not match.
ELEMENTALS_EXPERIMENT_ID=

# ---------------------------------------------------------------------------
# Kaggle — checkpoint persistence (unchanged by the distributed work)
# ---------------------------------------------------------------------------
# Only needed locally. On Kaggle this comes from Secrets.
KAGGLE_API_TOKEN=
